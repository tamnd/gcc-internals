      "version": 1,
      "versionNonce": 3037141,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Delete the fourteen stage names from the three boxes at the top and put them back from memory. Then do the\nsame with the right hand column of box 2, which is harder and worth more. If you can do both, you have the map.",
      "originalText": "Delete the fourteen stage names from the three boxes at the top and put them back from memory. Then do the\nsame with the right hand column of box 2, which is harder and worth more. If you can do both, you have the map.",
