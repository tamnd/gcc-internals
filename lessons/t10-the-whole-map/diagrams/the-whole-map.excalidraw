      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1  the driver          gcc, which runs other programs\n2  preprocess          cc1 -E, or cc1 doing it inline\n3  parse               C text becomes GENERIC\n4  gimplify            GENERIC becomes GIMPLE\n\n   none of these four is a pass\n   the pass manager has not started yet",
      "originalText": "1  the driver          gcc, which runs other programs\n2  preprocess          cc1 -E, or cc1 doing it inline\n3  parse               C text becomes GENERIC\n4  gimplify            GENERIC becomes GIMPLE\n\n   none of these four is a pass\n   the pass manager has not started yet",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "box004",
      "lineHeight": 1.25,
      "autoResize": true
