    {
      "id": "txt002",
      "type": "text",
      "x": 40,
      "y": 40,
      "width": 1061.44,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 15838,
      "version": 1,
      "versionNonce": 209458,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Everything before this point in the compiler could pretend the machine had as many places to put a value as\nthe program needed. This is where that stops being true, and it stops being true for one boring reason.",
      "originalText": "Everything before this point in the compiler could pretend the machine had as many places to put a value as\nthe program needed. This is where that stops being true, and it stops being true for one boring reason.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "txt003",
