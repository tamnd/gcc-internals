    {
      "id": "txt014",
      "type": "text",
      "x": 177.51999999999998,
      "y": 585.0,
      "width": 624.96,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
