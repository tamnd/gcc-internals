      "versionNonce": 2408767,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "three insns. the\nregisters are 64 bit\nand the arithmetic\nis 32, so the result\nhas to be sign\nextended back.",
      "originalText": "three insns. the\nregisters are 64 bit\nand the arithmetic\nis 32, so the result\nhas to be sign\nextended back.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
