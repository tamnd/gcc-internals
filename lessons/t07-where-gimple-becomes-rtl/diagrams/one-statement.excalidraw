      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "What a function is, after expand",
      "originalText": "What a function is, after expand",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "txt030",
      "type": "text",
      "x": 40,
      "y": 960,
      "width": 813.4399999999999,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 237570,
      "version": 1,
      "versionNonce": 3141870,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A doubly linked list, in the order the instructions will run. The blocks are still\nrecorded, on notes in the chain, but they are no longer the thing you walk.",
      "originalText": "A doubly linked list, in the order the instructions will run. The blocks are still\nrecorded, on notes in the chain, but they are no longer the thing you walk.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
