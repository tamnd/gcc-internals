      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "note  1   ->  note  7   ->  insn  2   ->  note  3   ->  debug 9 .. 14\n                 |             |\n              block 2       the argument arrives",
      "originalText": "note  1   ->  note  7   ->  insn  2   ->  note  3   ->  debug 9 .. 14\n                 |             |\n              block 2       the argument arrives",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "center",
