      "locked": false,
      "text": "one insn, two\nthings in it. adding\nwrecks the flags\nand the insn has\nto say so.",
      "originalText": "one insn, two\nthings in it. adding\nwrecks the flags\nand the insn has\nto say so.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "txt023",
      "type": "text",
      "x": 1420,
      "y": 370,
      "width": 186.0,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
