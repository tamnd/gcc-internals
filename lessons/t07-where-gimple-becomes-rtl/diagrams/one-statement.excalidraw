      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "txt033",
      "type": "text",
      "x": 1000,
      "y": 1040,
      "width": 669.6,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 261327,
      "version": 1,
      "versionNonce": 3456057,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "In L1 at expand the chain is 40 entries and 13 of them are instructions.\nThe other 27 are notes saying where a block starts, labels, and debug\nentries recording where a variable lives so a debugger can find it.\n\nNone of the 27 becomes a byte of machine code. All of them are RTX.",
      "originalText": "In L1 at expand the chain is 40 entries and 13 of them are instructions.\nThe other 27 are notes saying where a block starts, labels, and debug\nentries recording where a variable lives so a debugger can find it.\n\nNone of the 27 becomes a byte of machine code. All of them are RTX.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
