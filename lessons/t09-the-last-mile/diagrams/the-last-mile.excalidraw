    },
    {
      "id": "txt021",
      "type": "text",
      "x": 40,
      "y": 890,
      "width": 1041.6,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 166299,
      "version": 1,
      "versionNonce": 2199309,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every pass before this one uses the description to ask does this pattern match my RTL. `final` uses it to\nask what does this pattern print. Same file, and the second question is the one that can run C.",
      "originalText": "Every pass before this one uses the description to ask does this pattern match my RTL. `final` uses it to\nask what does this pattern print. Same file, and the second question is the one that can run C.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "box022",
      "type": "rectangle",
      "x": 40,
      "y": 970,
      "width": 900,
      "height": 200,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 174218,
      "version": 1,
      "versionNonce": 2304038,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "txt023",
