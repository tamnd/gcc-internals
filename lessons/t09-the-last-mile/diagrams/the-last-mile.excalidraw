      "versionNonce": 3037141,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "what happens to it next\n\n  as       text  ->  object file    encodes, builds the section and symbol tables,\n                                    turns unknown addresses into relocations\n  ld       .o    ->  executable     resolves the relocations, lays out the sections\n  loader   file  ->  process        maps the sections, sets the permissions\n\n  GCC stops at the first arrow because everything past it is the same for\n  every language that can produce an object file.",
      "originalText": "what happens to it next\n\n  as       text  ->  object file    encodes, builds the section and symbol tables,\n                                    turns unknown addresses into relocations\n  ld       .o    ->  executable     resolves the relocations, lays out the sections\n  loader   file  ->  process        maps the sections, sets the permissions\n\n  GCC stops at the first arrow because everything past it is the same for\n  every language that can produce an object file.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "box028",
      "lineHeight": 1.25,
      "autoResize": true
    },
