      "roundness": null,
      "seed": 213813,
      "version": 1,
      "versionNonce": 2827683,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "l1.s, 46 lines\n\n  12  instructions      the assembler encodes these\n  14  directives        the assembler acts on these\n   5  labels            the assembler records the addresses\n  14  comments          the assembler throws these away\n   1  blank             the same",
      "originalText": "l1.s, 46 lines\n\n  12  instructions      the assembler encodes these\n  14  directives        the assembler acts on these\n   5  labels            the assembler records the addresses\n  14  comments          the assembler throws these away\n   1  blank             the same",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "box026",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
