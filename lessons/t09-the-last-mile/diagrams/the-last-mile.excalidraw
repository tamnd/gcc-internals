      "updated": 1,
      "link": null,
      "locked": false,
      "text": "        add     w0, w0, w1      // 12   [c=4 l=4]  *addsi3_aarch64/1\n                                   |      |   |     |               |\n                                   |      |   |     |               which row of the table\n                                   |      |   |     which define_insn emitted it\n                                   |      |   how many bytes it should assemble to\n                                   |      what the cost model thought it was worth\n                                   the uid of the RTL insn, also in the .final dump",
      "originalText": "        add     w0, w0, w1      // 12   [c=4 l=4]  *addsi3_aarch64/1\n                                   |      |   |     |               |\n                                   |      |   |     |               which row of the table\n                                   |      |   |     which define_insn emitted it\n                                   |      |   how many bytes it should assemble to\n                                   |      what the cost model thought it was worth\n                                   the uid of the RTL insn, also in the .final dump",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "box017",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "txt019",
      "type": "text",
      "x": 1300,
      "y": 580,
      "width": 418.5,
      "height": 150.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 150461,
      "version": 1,
      "versionNonce": 1989851,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "`-dp` is what makes any of this checkable.\nWithout it the assembly is just assembly and\nthe link back to the machine description is\nsomething you have to guess at.\n\nThe uid is the useful field, because the same\nnumber is in the .final RTL dump. Everything\nelse in the annotation is a convenience.",
      "originalText": "`-dp` is what makes any of this checkable.\nWithout it the assembly is just assembly and\nthe link back to the machine description is\nsomething you have to guess at.\n\nThe uid is the useful field, because the same\nnumber is in the .final RTL dump. Everything\nelse in the annotation is a convenience.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "txt020",
      "type": "text",
      "x": 40,
      "y": 850,
      "width": 658.4399999999999,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 158380,
      "version": 1,
      "versionNonce": 2094580,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "3. The machine description is read the other way round here",
      "originalText": "3. The machine description is read the other way round here",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
