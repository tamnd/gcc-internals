    {
      "id": "txt008",
      "type": "text",
      "x": 849.0,
      "y": 341.25,
      "width": 682.0,
      "height": 357.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
