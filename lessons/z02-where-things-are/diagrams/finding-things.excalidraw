      "versionNonce": 2618225,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Nobody knows where anything is.\n\nThe people who look like they do\nare running one of five routes,\nin under a minute, and then\nreading the answer.\n\nPick the route from the shape of\nwhat you are looking at. That is\nthe entire trick.",
      "originalText": "Nobody knows where anything is.\n\nThe people who look like they do\nare running one of five routes,\nin under a minute, and then\nreading the answer.\n\nPick the route from the shape of\nwhat you are looking at. That is\nthe entire trick.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "box024",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "txt026",
      "type": "text",
      "x": 1640,
      "y": 700,
      "width": 312.48,
      "height": 192.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 205894,
      "version": 1,
      "versionNonce": 2722954,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Three things people get wrong first:\n\n  gcc/config has 52 directories\n  and 49 of them are ports\n\n  Simulating statement is printed by\n  tree-ssa-propagate.cc, not by the\n  pass whose dump it lands in\n\n  git grep never answers when, and\n  when is often the real question",
      "originalText": "Three things people get wrong first:\n\n  gcc/config has 52 directories\n  and 49 of them are ports\n\n  Simulating statement is printed by\n  tree-ssa-propagate.cc, not by the\n  pass whose dump it lands in\n\n  git grep never answers when, and\n  when is often the real question",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
