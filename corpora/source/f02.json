    "      unsigned src_line = LOCATION_LINE (loc);",
    "",
    "      if (print.source == NULL)",
    "\tprint.source = token;",
    "",
    "      if (src_line != print.src_line",
    "\t  && do_line_adjustments",
    "\t  && !in_pragma)",
    "\t{",
    "\t  line_marker_emitted = do_line_change (pfile, token, loc, false);",
    "\t  putc (' ', print.outf);",
    "\t  print.printed = true;",
    "\t}",
    "      else if (print.source->flags & PREV_WHITE",
    "\t       || (print.prev",
    "\t\t   && cpp_avoid_paste (pfile, print.prev, token))",
    "\t       || (print.prev == NULL && token->type == CPP_HASH))",
    "\t{",
    "\t  putc (' ', print.outf);",
    "\t  print.printed = true;",
    "\t}"
   ]
