   "path": "gcc/gcc.cc",
   "first": 9398,
   "last": 9438,
   "about": "Choosing a row for a file, backwards, so a -specs= entry wins",
   "lines": [
    "lookup_compiler (const char *name, size_t length, const char *language)",
    "{",
    "  struct compiler *cp;",
    "",
    "  /* If this was specified by the user to be a linker input, indicate that.  */",
    "  if (language != 0 && language[0] == '*')",
    "    return 0;",
    "",
    "  /* Otherwise, look for the language, if one is spec'd.  */",
    "  if (language != 0)",
    "    {",
    "      for (cp = compilers + n_compilers - 1; cp >= compilers; cp--)",
    "\tif (cp->suffix[0] == '@' && !strcmp (cp->suffix + 1, language))",
    "\t  {",
    "\t    if (name != NULL && strcmp (name, \"-\") == 0",
    "\t\t&& (strcmp (cp->suffix, \"@c-header\") == 0",
    "\t\t    || strcmp (cp->suffix, \"@c++-header\") == 0)",
    "\t\t&& !have_E)",
    "\t      fatal_error (input_location,",
    "\t\t\t   \"cannot use %<-%> as input filename for a \"",
    "\t\t\t   \"precompiled header\");",
    "",
    "\t    return cp;",
    "\t  }",
    "",
    "      error (\"language %s not recognized\", language);",
    "      return 0;",
    "    }",
    "",
    "  /* Look for a suffix.  */",
    "  for (cp = compilers + n_compilers - 1; cp >= compilers; cp--)",
    "    {",
    "      if (/* The suffix `-' matches only the file name `-'.  */",
    "\t  (!strcmp (cp->suffix, \"-\") && !strcmp (name, \"-\"))",
    "\t  || (strlen (cp->suffix) < length",
    "\t      /* See if the suffix matches the end of NAME.  */",
    "\t      && !strcmp (cp->suffix,",
    "\t\t\t  name + length - strlen (cp->suffix))",
    "\t ))",
    "\tbreak;",
    "    }"
