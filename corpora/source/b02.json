  "why": {
   "path": "Makefile.tpl",
   "first": 1747,
   "last": 1756,
   "about": "GCC's own comment on why every stage builds in a directory called gcc",
   "lines": [
    "# We name the build directories for the various stages \"stage1-gcc\",",
    "# \"stage2-gcc\",\"stage3-gcc\", etc.",
    "",
    "# Since the 'compare' process will fail (on debugging information) if any",
    "# directory names are different, we need to link the gcc directory for",
    "# the previous stage to a constant name ('prev-gcc'), and to make the name of",
    "# the build directories constant as well. For the latter, we use naked names",
    "# like 'gcc', because the scripts in that directory assume it.  We use",
    "# mv on platforms where symlinks to directories do not work or are not",
    "# reliable."
   ]
  },
  "start": {
   "path": "Makefile.tpl",
   "first": 1767,
   "last": 1782,
   "about": "Unpacking a stage, which is renaming every bootstrap module into place",
   "lines": [
    "stage[+id+]-start::",
    "\t@: $(MAKE); $(stage); \\",
    "\techo stage[+id+] > stage_current; \\",
    "\techo stage[+id+] > stage_last; \\",
    "\t$(SHELL) $(srcdir)/mkinstalldirs $(HOST_SUBDIR)[+",
    "   FOR host_modules +][+ IF bootstrap +]",
    "@if [+ module +]",
    "\t@cd $(HOST_SUBDIR); [ -d stage[+id+]-[+module+] ] || \\",
    "\t  mkdir stage[+id+]-[+module+]; \\",
    "\tmv stage[+id+]-[+module+] [+module+][+ IF prev +]; \\",
    "\tmv stage[+prev+]-[+module+] prev-[+module+] || test -f stage[+prev+]-lean [+ ENDIF prev +]",
    "@endif [+ module +][+ ENDIF bootstrap +][+ ENDFOR host_modules +]",
    "\t@[ -d stage[+id+]-$(TARGET_SUBDIR) ] || \\",
    "\t  mkdir stage[+id+]-$(TARGET_SUBDIR); \\",
    "\tmv stage[+id+]-$(TARGET_SUBDIR) $(TARGET_SUBDIR)[+ IF prev +]; \\",
    "\tmv stage[+prev+]-$(TARGET_SUBDIR) prev-$(TARGET_SUBDIR) || test -f stage[+prev+]-lean [+ ENDIF prev +]"
   ]
  },
  "bubble": {
   "path": "Makefile.tpl",
   "first": 1797,
   "last": 1815,
   "about": "Why it is one dependency chain and not a script, which GCC calls bubbling",
   "lines": [
    "# Bubble a bug fix through all the stages up to stage [+id+].  They are",
    "# remade, but not reconfigured.  The next stage (if any) will not be",
    "# reconfigured either.",
    ".PHONY: stage[+id+]-bubble",
    "stage[+id+]-bubble:: [+ IF prev +]stage[+prev+]-bubble[+ ENDIF +]",
    "\t@r=`${PWD_COMMAND}`; export r; \\",
    "\ts=`cd $(srcdir); ${PWD_COMMAND}`; export s; \\",
    "\tif test -f stage[+id+]-lean [+",
    "\t  IF prev +]|| test -f stage[+prev+]-lean [+ ENDIF prev +]; then \\",
    "\t  echo Skipping rebuild of stage[+id+]; \\",
    "\telse \\",
    "\t  $(MAKE) stage[+id+]-start; \\[+IF lean +]",
    "\t  if $(LEAN); then \\",
    "\t    rm -rf stage[+lean+]-*; \\",
    "\t    $(STAMP) stage[+lean+]-lean; \\",
    "\t  fi; \\[+ ENDIF lean +]",
    "\t  $(MAKE) $(RECURSE_FLAGS_TO_PASS) all-stage[+id+]; \\",
    "\tfi[+ IF compare-target +]",
    "\t$(MAKE) $(RECURSE_FLAGS_TO_PASS) [+compare-target+][+ ENDIF compare-target +]"
   ]
  },
  "compare": {
   "path": "Makefile.tpl",
   "first": 1824,
   "last": 1857,
   "about": "The oracle itself, in thirty four lines of shell inside a makefile",
   "lines": [
    "[+compare-target+]:",
    "\t@r=`${PWD_COMMAND}`; export r; \\",
    "\ts=`cd $(srcdir); ${PWD_COMMAND}`; export s; \\",
    "\tif test -f stage[+prev+]-lean; then \\",
    "\t  echo Cannot compare object files as stage [+prev+] was deleted.; \\",
    "\t  exit 0; \\",
    "\tfi; \\",
    "\t: $(MAKE); $(stage); \\",
    "\trm -f .bad_compare; \\",
    "\techo Comparing stages [+prev+] and [+id+]; \\",
    "        sed=`echo stage[+id+] | sed 's,^stage,,;s,.,.,g'`; \\",
    "\tfiles=`find stage[+id+]-* -name \"*$(objext)\" -print | \\",
    "\t\t sed -n s,^stage$$sed-,,p`; \\",
    "\tfor file in $${files} ${extra-compare}; do \\",
    "\t  f1=$$r/stage[+prev+]-$$file; f2=$$r/stage[+id+]-$$file; \\",
    "\t  if test ! -f $$f1; then continue; fi; \\",
    "\t  $(do-[+compare-target+]) > /dev/null 2>&1; \\",
    "\t  if test $$? -eq 1; then \\",
    "\t    case $$file in \\",
    "\t      @compare_exclusions@) \\",
    "\t        echo warning: $$file differs ;; \\",
    "\t      *) \\",
    "\t        echo $$file differs >> .bad_compare ;; \\",
    "\t    esac; \\",
    "\t  fi; \\",
    "\tdone; \\",
    "\tif [ -f .bad_compare ]; then \\",
    "\t  echo \"Bootstrap comparison failure!\"; \\",
    "\t  cat .bad_compare; \\",
    "\t  exit 1; \\",
    "\telse \\",
    "\t  echo Comparison successful.; \\",
    "\tfi; \\",
    "\t$(STAMP) [+compare-target+][+ IF prev +]"
   ]
  },
