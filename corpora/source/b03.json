  "passnames": {
   "path": "gcc/gdbhooks.py",
   "first": 700,
   "last": 709,
   "about": "break-on-pass completes from passes.def, which holds class names",
   "lines": [
    "class PassNames:",
    "    \"\"\"Parse passes.def, gathering a list of pass class names\"\"\"",
    "    def __init__(self):",
    "        srcdir = find_gcc_source_dir()",
    "        self.names = []",
    "        with open(os.path.join(srcdir, 'passes.def')) as f:",
    "            for line in f:",
    "                m = re.match(r'\\s*NEXT_PASS \\(([^,]+).*\\);', line)",
    "                if m:",
    "                    self.names.append(m.group(1))"
   ]
  },
