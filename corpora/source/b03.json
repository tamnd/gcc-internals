  "dbgcnt": {
   "path": "gcc/dbgcnt.cc",
   "first": 63,
   "last": 99,
   "about": "The whole of a debug counter: one increment and a range to compare against",
   "lines": [
    "bool",
    "dbg_cnt (enum debug_counter index)",
    "{",
    "  unsigned v = ++count[index];",
    "",
    "  if (!limits[index].exists ())",
    "    return true;",
    "  else if (limits[index].is_empty ())",
    "    return false;",
    "",
    "  unsigned last = limits[index].length () - 1;",
    "  unsigned int min = limits[index][last].first;",
    "  unsigned int max = limits[index][last].second;",
    "",
    "  if (v < min)",
    "    return false;",
    "  else if (v == min)",
    "    {",
    "      print_limit_reach (map[index].name, v, false);",
    "      if (min == max)",
    "\t{",
    "\t  print_limit_reach (map[index].name, v, true);",
    "\t  limits[index].pop ();",
    "\t}",
    "      return true;",
    "    }",
    "  else if (v < max)",
    "    return true;",
    "  else if (v == max)",
    "    {",
    "      print_limit_reach (map[index].name, v, true);",
    "      limits[index].pop ();",
    "      return true;",
    "    }",
    "  else",
    "    return false;",
    "}"
   ]
  }
