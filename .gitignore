__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/
build/
dist/
*.egg-info/
site/_build/
.DS_Store

# GCC leaves its dumps next to the input, and there are 236 of them per file at -O2
*.c.[0-9][0-9][0-9]t.*
*.c.[0-9][0-9][0-9]r.*
*.c.[0-9][0-9][0-9]i.*
*.o
*.so
*.s

# generated, never committed
corpora/dumps/**/*.gz

# tools/cecache/store is deliberately NOT ignored. Every Compiler Explorer response the book
# depends on is committed, because the tier 0 parity job reads them and a cache that CI
# populates from a third party service turns somebody else's outage into our build failure.
# Adding one is `just ce-refresh`, on a laptop, reviewed as a diff.

# Marimo caches the last run of a notebook beside it. The island build reruns every cell
# anyway, so this is scratch.
__marimo__/
